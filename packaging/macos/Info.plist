<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Passed to `vpk pack --plist`. The release workflow replaces __VERSION__. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>AGT</string>
    <key>CFBundleDisplayName</key>
    <string>AGT</string>
    <key>CFBundleIdentifier</key>
    <string>io.notics.agt</string>
    <key>CFBundleExecutable</key>
    <string>agt</string>
    <!-- Contents/Resources/AGT.icns, drawn by make_icon.py. -->
    <key>CFBundleIconFile</key>
    <string>AGT</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.4</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Menu-bar app: no Dock icon or app menu. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>AGT records your voice while you dictate, and during meeting notes you start, and transcribes it on this Mac.</string>
    <!-- Meeting notes: the other side of a call (Core Audio process tap). -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>AGT hears the other people in your meetings so it can transcribe them on this Mac.</string>
</dict>
</plist>
